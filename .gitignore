# Dependencies and AdonisJS build
node_modules
build
tmp/*
!tmp/.gitkeep
# AdonisJS codegen output is gitignored, except route-derived files.
# "ace build" never boots the app nor runs the routesScanned hook, so files
# derived from committed routes are never regenerated during a build and a
# fresh checkout (CI/Railway) would fail. Everything else under .adonisjs/
# is rewritten by "ace build" itself before tsc/vite run.
.adonisjs/*
!.adonisjs/client
.adonisjs/client/*
!.adonisjs/client/registry
!.adonisjs/server
.adonisjs/server/*
!.adonisjs/server/routes.d.ts

# Secrets
.env
.env.local
.env.production.local
.env.development.local

# Frontend assets compiled code
public/assets

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store

# Agent tooling
.claude/scheduled_tasks.lock

# TypeScript incremental build info
*.tsbuildinfo
