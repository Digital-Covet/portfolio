# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# IAM (Better Auth OAuth2 provider, see iam-digitalcovet)
# Dev IAM runs on http://localhost:5173, prod https://iam.digitalcovet.com
IAM_BASE_URL=http://localhost:5173
OAUTH_CLIENT_ID=portfolio
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth2/callback/portfolio
OAUTH_SCOPES="openid profile email"
# Same value as IAM BETTER_AUTH_SECRET, used to verify front-channel logout tokens
FRONT_CHANNEL_LOGOUT_SECRET=

# Supabase Postgres (shared pooler for runtime, direct for migrations)
DATABASE_URL=
DIRECT_URL=