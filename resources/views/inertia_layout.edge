<!DOCTYPE html>
<html data-theme="{{ request.plainCookie('app_theme', { defaultValue: 'dark', encoded: false }) === 'light' ? 'light' : 'dark' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>try{var m=document.cookie.match(/app_theme=(\w+)/);if(m&&m[1]==='system'){document.documentElement.setAttribute('data-theme',matchMedia('(prefers-color-scheme: light)').matches?'light':'dark')}}catch(e){}</script>
    <title data-inertia>
      AdonisJS
    </title>

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>

